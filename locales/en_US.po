#: ajax/action.php
msgid "O MailTech está desativado. Ative-o em Configurar > Plugins."
msgstr "MailTech is turned off. Activate it in Setup > Plugins."

#: src/Actions.php
msgid "Muitos testes em pouco tempo. Espere %d segundo e tente de novo."
msgid_plural "Muitos testes em pouco tempo. Espere %d segundos e tente de novo."
msgstr[0] "Too many tests in a short time. Wait %d second and try again."
msgstr[1] "Too many tests in a short time. Wait %d seconds and try again."

#: src/Actions.php
msgid "%d e-mail reenviado."
msgid_plural "%d e-mails reenviados."
msgstr[0] "%d email resent."
msgstr[1] "%d emails resent."

#: src/Actions.php
msgid "%d e-mail não pôde ser reenviado."
msgid_plural "%d e-mails não puderam ser reenviados."
msgstr[0] "%d email could not be resent."
msgstr[1] "%d emails could not be resent."

#: src/Actions.php
msgid "%d e-mail cancelado."
msgid_plural "%d e-mails cancelados."
msgstr[0] "%d email cancelled."
msgstr[1] "%d emails cancelled."

#: src/Actions.php
msgid "%d e-mail não pôde ser cancelado (só dá para cancelar o que ainda está na fila)."
msgid_plural "%d e-mails não puderam ser cancelados (só dá para cancelar o que ainda está na fila)."
msgstr[0] "%d email could not be cancelled (only emails still in the queue can be cancelled)."
msgstr[1] "%d emails could not be cancelled (only emails still in the queue can be cancelled)."

#: src/Actions.php
msgid "%d e-mail apagado."
msgid_plural "%d e-mails apagados."
msgstr[0] "%d email deleted."
msgstr[1] "%d emails deleted."

#: src/Actions.php
msgid "%d e-mail não pôde ser apagado (cancele antes o que ainda está na fila)."
msgid_plural "%d e-mails não puderam ser apagados (cancele antes o que ainda está na fila)."
msgstr[0] "%d email could not be deleted (cancel what is still in the queue first)."
msgstr[1] "%d emails could not be deleted (cancel what is still in the queue first)."

#: src/Actions.php
msgid "%d e-mail cancelado: a fila está vazia."
msgid_plural "%d e-mails cancelados: a fila está vazia."
msgstr[0] "%d email cancelled: the queue is empty."
msgstr[1] "%d emails cancelled: the queue is empty."

#: src/Actions.php
msgid "Fila processada: %d e-mail enviado."
msgid_plural "Fila processada: %d e-mails enviados."
msgstr[0] "Queue processed: %d email sent."
msgstr[1] "Queue processed: %d emails sent."

#: src/Actions.php
msgid "%d e-mail continua na fila (agendado para depois ou com falha)."
msgid_plural "%d e-mails continuam na fila (agendados para depois ou com falha)."
msgstr[0] "%d email is still in the queue (scheduled for later or failing)."
msgstr[1] "%d emails are still in the queue (scheduled for later or failing)."

#: src/Actions.php
msgid "Não entendi o que foi pedido. Recarregue a página e tente de novo."
msgstr "The request was not understood. Reload the page and try again."

#: src/Actions.php
msgid "Seu perfil não tem permissão para fazer isso no MailTech."
msgstr "Your profile is not allowed to do this in MailTech."

#: src/Actions.php
msgid "Algo deu errado ao executar a ação. Nada foi alterado; tente de novo."
msgstr "Something went wrong while running the action. Nothing was changed; try again."

#: src/Actions.php
msgid "Configuração de envio salva."
msgstr "Sending settings saved."

#: src/Actions.php
msgid "Configuração salva. O envio de e-mails do GLPI foi DESLIGADO."
msgstr "Settings saved. GLPI email sending was turned OFF."

#: src/Actions.php
msgid "Configuração salva. O envio de e-mails do GLPI foi LIGADO."
msgstr "Settings saved. GLPI email sending was turned ON."

#: src/Actions.php
msgid "Conexão com o servidor de envio funcionando."
msgstr "The connection to the mail server is working."

#: src/Actions.php templates/sending.html.twig templates/template_form.html.twig
msgid "Informe um e-mail válido para receber o teste. Exemplo: voce@suaempresa.com.br"
msgstr "Enter a valid email address to receive the test. Example: you@yourcompany.com"

#: src/Actions.php
msgid "Enviar o e-mail para %s"
msgstr "Send the email to %s"

#: src/Actions.php
msgid "E-mail de teste enviado para %s. Confira a caixa de entrada (e a pasta de spam)."
msgstr "Test email sent to %s. Check the inbox (and the spam folder)."

#: src/Actions.php
msgid "Falta informar o servidor de envio e a porta."
msgstr "The mail server and port are missing."

#: src/Actions.php
msgid "Preencha o servidor e a porta, clique em Salvar e teste de novo."
msgstr "Fill in the server and the port, click Save and test again."

#: src/Actions.php src/Health.php
msgid "Falta informar o e-mail do remetente."
msgstr "The sender email address is missing."

#: src/Actions.php
msgid "Preencha o e-mail do remetente, clique em Salvar e teste de novo."
msgstr "Fill in the sender email address, click Save and test again."

#: src/Actions.php src/Health.php
msgid "O remetente \"%s\" não é um endereço de e-mail de verdade."
msgstr "The sender \"%s\" is not a real e-mail address."

#: src/Actions.php
msgid "O %s recusa e-mails com esse remetente. Em \"E-mail do remetente\", informe o endereço da conta que faz o login, clique em Salvar e teste de novo."
msgstr "%s refuses e-mails from that sender. In \"Sender email\", enter the address of the account that signs in, click Save and test again."

#: src/Actions.php
msgid "Avisos do MailTech ligados."
msgstr "MailTech notices turned on."

#: src/Actions.php
msgid "Avisos do MailTech desligados: as regras não geram e-mails até você ligar de novo."
msgstr "MailTech notices turned off: the rules create no emails until you turn them on again."

#: src/Actions.php
msgid "Essa regra não existe mais. Recarregue a página."
msgstr "This rule no longer exists. Reload the page."

#: src/Actions.php
msgid "Regra \"%s\" ligada."
msgstr "Rule \"%s\" turned on."

#: src/Actions.php
msgid "Regra \"%s\" desligada: ela não gera mais e-mails."
msgstr "Rule \"%s\" turned off: it no longer creates emails."

#: src/Actions.php
msgid "Regra \"%s\" salva."
msgstr "Rule \"%s\" saved."

#: src/Actions.php
msgid "Não foi possível criar a regra. Tente de novo."
msgstr "The rule could not be created. Try again."

#: src/Actions.php
msgid "Regra \"%s\" criada com a mensagem padrão. Você pode ajustar o texto em Modelos."
msgstr "Rule \"%s\" created with the default message. You can adjust the text under Templates."

#: src/Actions.php
msgid "Regra \"%s\" apagada, junto com a mensagem dela."
msgstr "Rule \"%s\" deleted, together with its message."

#: src/Actions.php
msgid "Escolhas por entidade salvas."
msgstr "Choices per entity saved."

#: src/Actions.php
msgid "Esse aviso do GLPI não existe mais. Recarregue a página."
msgstr "This GLPI notice no longer exists. Reload the page."

#: src/Actions.php
msgid "Aviso do GLPI ligado."
msgstr "GLPI notice turned on."

#: src/Actions.php
msgid "Aviso do GLPI desligado."
msgstr "GLPI notice turned off."

#: src/Actions.php
msgid "Modelo salvo."
msgstr "Template saved."

#: src/Actions.php
msgid "Estas variáveis não existem e vão aparecer no e-mail como texto: %s"
msgstr "These variables do not exist and will appear in the email as plain text: %s"

#: src/Actions.php
msgid "Tradução apagada. Quem usa esse idioma volta a receber o modelo padrão."
msgstr "Translation deleted. People using that language get the default template again."

#: src/Actions.php
msgid "[TESTE] %s"
msgstr "[TEST] %s"

#: src/Actions.php
msgid "Escolha o que fazer com os e-mails marcados."
msgstr "Choose what to do with the selected emails."

#: src/Actions.php src/Page.php
msgid "Marque pelo menos um e-mail da lista."
msgstr "Select at least one email from the list."

#: src/Actions.php src/Page.php templates/_test_result.html.twig templates/queue_detail.html.twig
msgid "O que tentar:"
msgstr "What to try:"

#: src/Actions.php
msgid "Não havia e-mails esperando na fila."
msgstr "There were no emails waiting in the queue."

#: src/Actions.php
msgid "Fila processada: não havia e-mails prontos para envio."
msgstr "Queue processed: there were no emails ready to send."

#: src/Actions.php
msgid "Rotina automática reativada: a fila volta a ser enviada sozinha."
msgstr "Automatic routine re-enabled: the queue is sent on its own again."

#: src/Actions.php
msgid "Regras da fila salvas."
msgstr "Queue rules saved."

#: src/Actions.php
msgid "Salvo: ao desinstalar o plugin, as regras, modelos e ajustes do MailTech SERÃO apagados."
msgstr "Saved: when the plugin is uninstalled, MailTech rules, templates and settings WILL be deleted."

#: src/Actions.php
msgid "Salvo: ao desinstalar o plugin, as regras, modelos e ajustes do MailTech ficam guardados."
msgstr "Saved: when the plugin is uninstalled, MailTech rules, templates and settings are kept."

#: src/Actions.php
msgid "Escolha o arquivo .json gerado pelo botão \"Exportar\" antes de importar."
msgstr "Choose the .json file created by the \"Export\" button before importing."

#: src/Actions.php src/Porter.php
msgid "Arquivo grande demais: o limite é 2 MB."
msgstr "File too large: the limit is 2 MB."

#: src/Actions.php
msgid "Importação concluída: %1$d regra(s) criada(s), %2$d atualizada(s)."
msgstr "Import finished: %1$d rule(s) created, %2$d updated."

#: src/Actions.php
msgid "Servidor de envio importado: digite a senha de novo em Envio."
msgstr "Mail server imported: type the password again under Sending."

#: src/Actions.php
msgid "Ajustes do MailTech restaurados para o padrão. As regras, os modelos e o servidor de envio não foram alterados."
msgstr "MailTech settings restored to their defaults. Rules, templates and the mail server were not changed."

