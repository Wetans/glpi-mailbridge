{% extends '@mailbridge/layout.html.twig' %}

{% block content %}
   <p class="mb-3">
      <a href="{{ list_url }}"><i class="ti ti-arrow-left" aria-hidden="true"></i> {{ __('Voltar para a fila', 'mailbridge') }}</a>
   </p>

   <div class="row g-3">
      <div class="col-12 col-xl-5">
         <div class="card mb-3">
            <div class="card-header">
               <h2 class="card-title h4 m-0 tm-break">{{ mail.subject ?: __('(sem assunto)', 'mailbridge') }}</h2>
            </div>
            <div class="card-body">
               <p>
                  <span class="badge bg-{{ mail.tone }}-lt">{{ mail.state_label }}</span>
                  <span class="tm-soft">{{ when }}</span>
               </p>
               <dl class="row mb-0">
                  <dt class="col-sm-4">{{ __('Para', 'mailbridge') }}</dt>
                  <dd class="col-sm-8 tm-break">{{ mail.recipientname and mail.recipientname != mail.recipient ? mail.recipientname ~ ' <' ~ mail.recipient ~ '>' : mail.recipient }}</dd>
                  <dt class="col-sm-4">{{ __('De', 'mailbridge') }}</dt>
                  <dd class="col-sm-8 tm-break">{{ mail.sendername ? mail.sendername ~ ' <' ~ mail.sender ~ '>' : mail.sender }}</dd>
                  {% if mail.replyto %}
                     <dt class="col-sm-4">{{ __('Responder para', 'mailbridge') }}</dt>
                     <dd class="col-sm-8 tm-break">{{ mail.replyto }}</dd>
                  {% endif %}
                  <dt class="col-sm-4">{{ __('Origem', 'mailbridge') }}</dt>
                  <dd class="col-sm-8">{{ mail.event_label }}{% if item_url %} · <a href="{{ item_url }}">{{ item_name }}</a>{% endif %}</dd>
                  <dt class="col-sm-4">{{ __('Criado em', 'mailbridge') }}</dt>
                  <dd class="col-sm-8">{{ created }} <span class="tm-soft">({{ ago }})</span></dd>
                  {% if sent %}
                     <dt class="col-sm-4">{{ __('Enviado em', 'mailbridge') }}</dt>
                     <dd class="col-sm-8">{{ sent }}</dd>
                  {% endif %}
                  <dt class="col-sm-4">{{ __('Tentativas com falha', 'mailbridge') }}</dt>
                  <dd class="col-sm-8 mb-0">{{ mail.tries }}</dd>
               </dl>
            </div>
            {% if tm.can.queue %}
               <div class="card-footer">
                  <form method="post" action="{{ tm.action_url }}" class="d-flex flex-wrap gap-2 m-0">
                     <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
                     <input type="hidden" name="action" value="queue_apply">
                     <input type="hidden" name="from_detail" value="1">
                     <button type="submit" name="row" value="resend:{{ mail.id }}" class="btn btn-primary"
                             {%- if mail.state == 'sent' %} data-tm-confirm="{{ __('Este e-mail já foi enviado. Enviar uma cópia de novo?', 'mailbridge') }}"{% endif %}>
                        <i class="ti ti-send" aria-hidden="true"></i> {{ mail.state == 'pending' ? __('Enviar agora', 'mailbridge') : __('Reenviar', 'mailbridge') }}
                     </button>
                     {% if mail.can_cancel %}
                        <button type="submit" name="row" value="cancel:{{ mail.id }}" class="btn btn-outline-secondary"
                                data-tm-confirm="{{ __('Cancelar este e-mail? Ele sai da fila e não será enviado.', 'mailbridge') }}">
                           {{ __('Cancelar', 'mailbridge') }}
                        </button>
                     {% endif %}
                     {% if mail.can_delete %}
                        <button type="submit" name="row" value="delete:{{ mail.id }}" class="btn btn-outline-danger"
                                data-tm-confirm="{{ __('Apagar este e-mail do histórico? Isso não pode ser desfeito.', 'mailbridge') }}">
                           <i class="ti ti-trash" aria-hidden="true"></i> {{ __('Apagar do histórico', 'mailbridge') }}
                        </button>
                     {% endif %}
                  </form>
               </div>
            {% endif %}
         </div>

         {% if attempts %}
            <div class="card">
               <div class="card-header"><h3 class="card-title h4 m-0">{{ __('Por que não saiu', 'mailbridge') }}</h3></div>
               <ul class="list-group list-group-flush">
                  {% for attempt in attempts %}
                     <li class="list-group-item">
                        <p class="mb-1">
                           <strong>{{ attempt.title }}</strong>
                           <span class="tm-soft">{{ attempt.date }}{% if attempt.gave_up %} · {{ __('o GLPI desistiu depois desta tentativa', 'mailbridge') }}{% endif %}</span>
                        </p>
                        {% if attempt.advice %}
                           <p class="fw-bold mb-1">{{ __('O que tentar:', 'mailbridge') }}</p>
                           <ul class="mb-1">
                              {% for tip in attempt.advice %}<li>{{ tip }}</li>{% endfor %}
                           </ul>
                        {% endif %}
                        {% if attempt.technical %}
                           <details>
                              <summary>{{ __('Detalhe técnico', 'mailbridge') }}</summary>
                              <code class="tm-break">{{ attempt.technical }}</code>
                           </details>
                        {% endif %}
                     </li>
                  {% endfor %}
               </ul>
            </div>
         {% endif %}
      </div>

      <div class="col-12 col-xl-7">
         <div class="card">
            <div class="card-header"><h3 class="card-title h4 m-0">{{ __('Como o e-mail ficou', 'mailbridge') }}</h3></div>
            <div class="card-body">
               {% if html %}
                  <iframe class="tm-preview" sandbox="" title="{{ __('Conteúdo do e-mail', 'mailbridge') }}"
                          srcdoc="{{ '<!doctype html><meta charset="utf-8"><body style="font-family:sans-serif;font-size:14px;margin:12px;color:#222;background:#fff">' ~ html ~ '</body>' }}"></iframe>
               {% endif %}
               <details class="mt-2"{{ html ? '' : ' open' }}>
                  <summary>{{ __('Ver a versão em texto simples', 'mailbridge') }}</summary>
                  <pre class="tm-pre mb-0">{{ mail.body_text }}</pre>
               </details>
            </div>
         </div>
      </div>
   </div>
{% endblock %}
