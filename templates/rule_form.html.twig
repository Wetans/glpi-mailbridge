{% extends '@mailbridge/layout.html.twig' %}
{% import '@mailbridge/macros.html.twig' as f %}

{% block content %}
   <p class="mb-3">
      <a href="{{ back_url }}"><i class="ti ti-arrow-left" aria-hidden="true"></i> {{ __('Voltar para as regras', 'mailbridge') }}</a>
   </p>

   <form method="post" action="{{ tm.action_url }}" data-track-changes="true" novalidate>
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
      <input type="hidden" name="action" value="save_rule">
      <input type="hidden" name="id" value="{{ id }}">

      {{ f.error_summary(errors) }}

      <div class="card mb-3">
         <div class="card-header">
            <h2 class="card-title h4 m-0">{{ is_new ? __('Nova regra de aviso', 'mailbridge') : __('Editar regra de aviso', 'mailbridge') }}</h2>
         </div>
         <div class="card-body">
            <div class="row g-3">
               <div class="col-12 col-md-6">
                  {{ f.select('event', __('Quando acontecer', 'mailbridge'), v.event, events, {
                     errors: errors, class: 'mb-0',
                     help: __('A mudança automática de "Novo" para "Em atendimento (atribuído)" não conta como mudança de status: para isso use "Chamado atribuído".', 'mailbridge')
                  }) }}
               </div>
               <div class="col-12 col-md-6">
                  {{ f.input('name', __('Nome da regra', 'mailbridge'), v.name, {
                     errors: errors, maxlength: 255, class: 'mb-0',
                     placeholder: __('Avisar o técnico quando receber um chamado', 'mailbridge'),
                     help: __('Só para você reconhecer a regra na lista. Em branco, usa o nome do acontecimento.', 'mailbridge')
                  }) }}
               </div>
            </div>
            <div class="mt-3">
               {{ f.switch('is_active', __('Regra ligada', 'mailbridge'), v.is_active, {
                  class: 'mb-0', help: __('Desligada, a regra fica guardada mas não gera e-mails.', 'mailbridge')
               }) }}
            </div>
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-header"><h2 class="card-title h4 m-0">{{ __('Quem recebe', 'mailbridge') }}</h2></div>
         <div class="card-body">
            <fieldset class="mb-3{{ errors.recipients is defined ? ' border border-danger rounded p-2' }}">
               <legend class="form-label">{{ __('Pessoas ligadas ao chamado', 'mailbridge') }}</legend>
               {% if errors.recipients is defined %}<p class="text-danger" role="alert">{{ errors.recipients }}</p>{% endif %}
               {{ f.switch('notify_assigned_users', __('Técnicos atribuídos ao chamado', 'mailbridge'), v.notify_assigned_users, {
                  help: __('No acontecimento "Chamado atribuído", recebe só quem acabou de ser atribuído.', 'mailbridge')
               }) }}
               {{ f.switch('notify_assigned_groups', __('Membros dos grupos técnicos atribuídos', 'mailbridge'), v.notify_assigned_groups, {
                  help: __('Cada pessoa do grupo recebe o próprio e-mail.', 'mailbridge')
               }) }}
               {{ f.switch('notify_requesters', __('Solicitantes do chamado', 'mailbridge'), v.notify_requesters, {
                  help: __('Quem abriu o chamado. Use com cuidado: o GLPI já tem avisos nativos para solicitantes.', 'mailbridge')
               }) }}
               {{ f.switch('notify_observers', __('Observadores do chamado', 'mailbridge'), v.notify_observers, {
                  class: 'mb-0', help: __('Pessoas incluídas como observadoras no chamado.', 'mailbridge')
               }) }}
            </fieldset>

            {{ f.textarea('extra_emails', __('E-mails fixos (opcional)', 'mailbridge'), v.extra_emails, {
               errors: errors, rows: 3, placeholder: "coordenacao@suaempresa.com.br",
               help: __('Um por linha. Sempre recebem este aviso, mesmo sem estar no chamado.', 'mailbridge')
            }) }}

            {{ f.switch('exclude_author', __('Não avisar quem executou a ação', 'mailbridge'), v.exclude_author, {
               class: 'mb-0', help: __('Exemplo: o técnico que escreveu o acompanhamento não recebe o próprio aviso.', 'mailbridge')
            }) }}
         </div>
      </div>

      <div class="card mb-3">
         <div class="card-body">
            <details class="tm-advanced"{{ has_filters ? ' open' }}>
               <summary>{{ __('Opções avançadas: avisar só em alguns chamados', 'mailbridge') }}</summary>
               <p class="tm-soft">{{ __('Sem filtros, a regra vale para todos os chamados.', 'mailbridge') }}</p>
               <div class="row g-3">
                  <div class="col-12 col-md-6">
                     <div class="tm-field">
                        <label class="form-label" for="dropdown_filter_entities_idtm">{{ __('Entidade (inclui as que estão dentro dela)', 'mailbridge') }}</label>
                        <div>{{ entity_dropdown|raw }}</div>
                        <div class="form-text">{{ __('A entidade raiz equivale a "todas".', 'mailbridge') }}</div>
                     </div>
                  </div>
                  <div class="col-12 col-md-6">
                     <div class="tm-field">
                        <label class="form-label" for="dropdown_filter_itilcategories_idtm">{{ __('Categoria (inclui as que estão dentro dela)', 'mailbridge') }}</label>
                        <div>{{ category_dropdown|raw }}</div>
                        <div class="form-text">{{ __('Em branco, qualquer categoria.', 'mailbridge') }}</div>
                     </div>
                  </div>
                  <div class="col-12 col-md-6">
                     {{ f.select('filter_type', __('Tipo do chamado', 'mailbridge'), v.filter_type, types, {class: 'mb-0'}) }}
                  </div>
                  <div class="col-12 col-md-6">
                     {{ f.select('filter_min_priority', __('Prioridade mínima', 'mailbridge'), v.filter_min_priority, priorities, {
                        class: 'mb-0', help: __('Avisa só quando a prioridade for esta ou maior.', 'mailbridge')
                     }) }}
                  </div>
               </div>
            </details>
         </div>
      </div>

      {% if tm.can.manage %}
         <div class="card tm-savebar">
            <div class="card-body d-flex flex-wrap align-items-center gap-2 py-2">
               <button type="submit" class="btn btn-primary">
                  <i class="ti ti-device-floppy" aria-hidden="true"></i> {{ is_new ? __('Criar regra', 'mailbridge') : __('Salvar', 'mailbridge') }}
               </button>
               <a class="btn btn-outline-secondary" href="{{ back_url }}">{{ __('Cancelar', 'mailbridge') }}</a>
               {% if template_url %}
                  <a class="btn btn-outline-secondary" href="{{ template_url }}">
                     <i class="ti ti-template" aria-hidden="true"></i> {{ __('Editar mensagem', 'mailbridge') }}
                  </a>
               {% endif %}
               <span class="tm-soft" id="tm-dirty-note" hidden>{{ __('Há alterações não salvas.', 'mailbridge') }}</span>
            </div>
         </div>
      {% endif %}
   </form>

   {% if not is_new and tm.can.manage %}
      <form method="post" action="{{ tm.action_url }}" class="mt-3">
         <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
         <input type="hidden" name="action" value="delete_rule">
         <input type="hidden" name="id" value="{{ id }}">
         <button type="submit" class="btn btn-outline-danger"
                 data-tm-confirm="{{ __('Apagar esta regra? A mensagem dela e as traduções também são apagadas. Isso não pode ser desfeito.', 'mailbridge') }}">
            <i class="ti ti-trash" aria-hidden="true"></i> {{ __('Apagar regra', 'mailbridge') }}
         </button>
      </form>
   {% endif %}
{% endblock %}
